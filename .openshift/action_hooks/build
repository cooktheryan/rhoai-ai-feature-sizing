#!/bin/bash
# OpenShift build hook

set -e

echo "---> Building RHOAI AI Feature Sizing Platform"

# Ensure uv is in PATH
export PATH="$HOME/.cargo/bin:$PATH"

# Ensure Node.js is in PATH
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env --use-on-cd)" 2>/dev/null || true
export PATH="$HOME/.local/share/fnm/node-versions/v20.*/installation/bin:$PATH"

echo "---> Syncing Python dependencies with uv"
uv sync --frozen

echo "---> Installing Node.js dependencies for UI"
cd ui
npm ci --production
npm run build
cd ..

echo "---> Generating RAG indices"
uv run generate || echo "Warning: RAG index generation failed, will use empty indices"

echo "---> Build completed successfully"