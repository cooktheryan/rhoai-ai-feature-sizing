#!/bin/bash
# OpenShift start hook

set -e

echo "---> Starting RHOAI AI Feature Sizing Platform"

# Ensure uv is in PATH
export PATH="$HOME/.cargo/bin:/opt/app-root/.cargo/bin:$PATH"

# Ensure Node.js is in PATH
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env --use-on-cd)" 2>/dev/null || true
export PATH="$HOME/.local/share/fnm/node-versions/v20.*/installation/bin:$PATH"

# Check if uv is available, if not try alternative paths
if ! command -v uv &> /dev/null; then
    echo "---> uv not found in PATH, checking alternative locations..."
    if [ -f "$HOME/.cargo/bin/uv" ]; then
        export PATH="$HOME/.cargo/bin:$PATH"
        echo "---> Found uv at $HOME/.cargo/bin/uv"
    elif [ -f "/opt/app-root/.cargo/bin/uv" ]; then
        export PATH="/opt/app-root/.cargo/bin:$PATH"
        echo "---> Found uv at /opt/app-root/.cargo/bin/uv"
    else
        echo "---> ERROR: uv not found, installing..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        export PATH="$HOME/.cargo/bin:$PATH"
    fi
fi

echo "---> uv version: $(uv --version)"

# Check if Node.js is available
if command -v node &> /dev/null; then
    echo "---> Node.js version: $(node --version)"
    echo "---> npm version: $(npm --version)"
else
    echo "---> WARNING: Node.js not found - UI server may not work"
fi

# Copy environment template to create .env if it doesn't exist
if [ ! -f "src/.env" ]; then
    echo "---> Creating environment file from template"
    cp env.template src/.env
fi

echo "---> Starting LlamaDeploy API server in background"
cd "$OPENSHIFT_REPO_DIR"

# Set environment variables to ensure binding to all interfaces
export UVICORN_HOST=0.0.0.0
export LLAMADEPLOY_HOST=0.0.0.0
export HOST=0.0.0.0

# Run LlamaDeploy on its default port 4501 (localhost only)
# The proxy will run on port 8080 and forward to 4501
LLAMADEPLOY_PORT=4501
PROXY_PORT=8080
nohup uv run -m llama_deploy.apiserver --host 0.0.0.0 --port $LLAMADEPLOY_PORT > llamadeploy.log 2>&1 &
LLAMADEPLOY_PID=$!

# Wait for API server to start
echo "---> Waiting for LlamaDeploy API server to start..."
sleep 10

# Wait for server to be ready by checking the status endpoint
echo "---> Checking if API server is responding..."
for i in {1..30}; do
    if curl -s http://localhost:$LLAMADEPLOY_PORT/status/ > /dev/null 2>&1; then
        echo "---> API server is ready!"
        break
    fi
    echo "---> Waiting for API server... (attempt $i/30)"
    sleep 2
done

echo "---> Deploying workflows"
LLAMA_DEPLOY_APISERVER_URL=http://localhost:$LLAMADEPLOY_PORT uv run llamactl deploy deployment.yml || echo "Warning: Workflow deployment failed"

echo "---> Starting UI server"
UI_PORT=3000
cd ui
if command -v node &> /dev/null; then
    echo "---> Starting Node.js UI server on port $UI_PORT"
    nohup npm start > ../ui.log 2>&1 &
    UI_PID=$!
    echo "---> UI server PID: $UI_PID"
else
    echo "---> ERROR: Node.js not available, UI server will not start"
    UI_PID=""
fi
cd ..

echo "---> RHOAI AI Feature Sizing Platform started"
echo "---> LlamaDeploy PID: $LLAMADEPLOY_PID"
echo "---> UI server PID: $UI_PID"

# Since LlamaDeploy binds to localhost only, we need to run it on a different port
# and use socat to forward from the external port
echo "---> Starting port forwarding to expose API on all interfaces"

# Check if socat is available, if not use Python proxy
if command -v socat &> /dev/null; then
    echo "---> Using socat for port forwarding"
    socat TCP-LISTEN:$PROXY_PORT,bind=0.0.0.0,fork TCP:localhost:$LLAMADEPLOY_PORT &
    PROXY_PID=$!
else
    echo "---> Using Python proxy for port forwarding"
    cat > proxy.py << 'EOF'
import http.server
import socketserver
import urllib.request
import urllib.parse
import json
import os
from urllib.error import URLError

class ProxyHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.proxy_request()
    
    def do_POST(self):
        self.proxy_request()
    
    def do_PUT(self):
        self.proxy_request()
    
    def do_DELETE(self):
        self.proxy_request()
    
    def proxy_request(self):
        try:
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length) if content_length > 0 else None
            
            # Route requests based on path
            if self.is_api_request():
                target_port = 4501  # LlamaDeploy API
            else:
                target_port = 3000  # UI Server
                
            target_url = f"http://localhost:{target_port}{self.path}"
            req = urllib.request.Request(target_url, data=body, method=self.command)
            
            for header, value in self.headers.items():
                if header.lower() not in ['host', 'connection']:
                    req.add_header(header, value)
            
            with urllib.request.urlopen(req) as response:
                self.send_response(response.status)
                for header, value in response.headers.items():
                    if header.lower() not in ['connection', 'transfer-encoding']:
                        self.send_header(header, value)
                self.end_headers()
                self.wfile.write(response.read())
                
        except URLError as e:
            self.send_error(502, f"Bad Gateway: {e}")
        except Exception as e:
            self.send_error(500, f"Internal Server Error: {e}")
    
    def is_api_request(self):
        """Determine if this is an API request vs UI request"""
        api_paths = ['/status/', '/deployments/', '/docs', '/openapi.json', '/api/']
        return any(self.path.startswith(path) for path in api_paths)

PORT = 8080
with socketserver.TCPServer(("", PORT), ProxyHandler) as httpd:
    print(f"Proxy server running on 0.0.0.0:{PORT}")
    httpd.serve_forever()
EOF
    python3 proxy.py &
    PROXY_PID=$!
fi

echo "---> Reverse proxy PID: $PROXY_PID"
echo "---> API available at: http://0.0.0.0:$PROXY_PORT"
echo "---> UI available at: http://0.0.0.0:$PROXY_PORT/deployments/rhoai-ai-feature-sizing/ui"

# Keep the container running by waiting for all processes
if [ -n "$UI_PID" ]; then
    wait $LLAMADEPLOY_PID $UI_PID $PROXY_PID
else
    wait $LLAMADEPLOY_PID $PROXY_PID
fi